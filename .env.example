# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://al_lio:change-me@localhost:5432/al_lio
# Opcional en local; obligatorio para ejecutar migraciones en producción.
DATABASE_MIGRATION_URL=

# ── Sesión propia ─────────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Genera una con: openssl rand -hex 32
SESSION_SECRET=

# Secreto compartido con al-lio-radar para verificar el webhook HMAC.
# Generar una sola vez con: openssl rand -hex 32
AL_LIO_RADAR_WEBHOOK_SECRET=
# Empty keeps v4 canonical-only. Enable one reviewed vertical at a time.
# Comma-separated allowlist: news,course,event,job. Keep job absent until the
# verified source/cycle pilot and private-state cutover are explicitly approved.
AL_LIO_RADAR_V4_PROJECT_DESTINATIONS=
# Radar publication controls are host-prefixed to keep the Compose boundary
# explicit. These defaults are dormant and cannot publish student content.
AL_LIO_RADAR_DELIVERY_SCHEMA_VERSION=3
AL_LIO_RADAR_AUTONOMOUS_PUBLICATION_ENABLED=false
AL_LIO_RADAR_AUTONOMOUS_PUBLICATION_DESTINATIONS=news
AL_LIO_RADAR_AUTONOMOUS_NEWS_SOURCE_CYCLE_MATRIX_JSON={}
AL_LIO_RADAR_DAILY_PUBLICATION_TIMEZONE=Europe/Madrid
AL_LIO_RADAR_DAILY_PUBLICATION_TIME=09:00
# Independent future capabilities. Do not couple these to the news pilot.
AL_LIO_RADAR_WEB_DISCOVERY_ENABLED=false
AL_LIO_RADAR_LEARNING_DISCOVERY_ENABLED=false
AL_LIO_RADAR_YOUTUBE_WATCH_ENABLED=false
AL_LIO_RADAR_JOB_RADAR_ENABLED=false
# Independent learning-resource receiver. Keep false until Radar #24 and
# AL-LIO #202 contract fixtures have been reviewed together.
AL_LIO_RADAR_LEARNING_INGEST_ENABLED=false
# Keep false until canonical course/event parity has been reviewed locally.
# true hides unverified tech_opportunities/fp_content_items from students.
AL_LIO_VERIFIED_OPPORTUNITIES_ONLY=false

TARGET_USER_EMAIL=

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# Google OAuth - un solo cliente de Google Cloud, dos redirect URIs
# registrados: uno para el login (identidad, sin scope de Calendar) y otro
# para conectar Calendar por separado desde dentro de la app ya autenticada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IDENTITY_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Correo transaccional (Resend) ───────────────────────────────────────────
# Confirmación de registro y recuperación de contraseña.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── URL pública ───────────────────────────────────────────────────────────
BASE_URL=http://localhost:3000
# Opcional. Solo hace falta si BASE_URL no es alcanzable públicamente (por
# ejemplo, probando en local en un puerto no estándar) - los correos
# transaccionales usan esto para el logo, porque el cliente de correo lo
# carga desde fuera, no desde este servidor. En producción no se toca:
# cae automáticamente en BASE_URL si se deja vacío.
PUBLIC_ASSET_BASE_URL=
