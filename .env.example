# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://al_lio:change-me@localhost:5432/al_lio

# ── Sesión propia ─────────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Genera una con: openssl rand -hex 32
SESSION_SECRET=

TARGET_USER_EMAIL=

INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Noticias / Radar diario ───────────────────────────────────────────────
# Base URL usada por scripts/sync-news.mjs cuando se ejecuta `npm run sync:news`
BASE_URL=http://localhost:3000
