{
  "name": "techlife-control-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run verify:startup",
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run verify:startup",
    "start": "next start",
    "stop:app": "node scripts/stop-project-next.mjs",
    "clean:next": "node scripts/clean-next.mjs",
    "dev:clean": "npm run verify:startup && npm run stop:app && npm run clean:next && next dev",
    "build:clean": "npm run clean:next && next build",
    "prod:local": "node scripts/run-production.mjs",
    "restart:prod": "npm run stop:app && npm run build:clean && node scripts/smoke-production.mjs && npm run prod:local",
    "lint": "eslint app components lib middleware.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:project": "node scripts/check-project.mjs",
    "audit:schema": "node scripts/audit-schema-code.mjs",
    "smoke": "node scripts/smoke-local.mjs",
    "sync:news": "node scripts/sync-news.mjs",
    "supabase:check": "node scripts/check-supabase-remote.mjs",
    "supabase:apply": "node scripts/apply-supabase-sql.mjs",
    "import:opportunities": "node scripts/import-tech-opportunities.mjs",
    "import:courses": "node scripts/import-courses.mjs",
    "import:hackathons": "node scripts/import-hackathons.mjs",
    "seed:tasks": "node scripts/seed-semanal-tasks.mjs",
    "verify:startup": "npm run check:project && npm run audit:schema && npm run typecheck",
    "verify:cheap": "npm run verify:startup && npm run lint",
    "verify:prod": "npm run stop:app && npm run build:clean && node scripts/smoke-production.mjs",
    "test": "npm run check:project && npm run typecheck",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
