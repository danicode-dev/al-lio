{
  "name": "al-lio",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web para organizar tareas, calendario, formacion, oportunidades y seguimiento de progreso.",
  "license": "MIT",
  "author": "Daniel Garcia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danicode-dev/al-lio.git"
  },
  "bugs": {
    "url": "https://github.com/danicode-dev/al-lio/issues"
  },
  "homepage": "https://al-lio.danielcode.dev",
  "keywords": [
    "productivity",
    "education",
    "career",
    "nextjs",
    "postgresql"
  ],
  "scripts": {
    "predev": "npm run verify:startup",
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run verify:startup",
    "start": "next start",
    "stop:app": "node scripts/stop-project-next.mjs",
    "clean:next": "node scripts/clean-next.mjs",
    "dev:clean": "npm run verify:startup && npm run stop:app && npm run clean:next && next dev",
    "build:clean": "npm run clean:next && next build",
    "prod:local": "node scripts/run-production.mjs",
    "restart:prod": "npm run stop:app && npm run build:clean && node scripts/smoke-production.mjs && npm run prod:local",
    "lint": "eslint app components lib middleware.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:project": "node scripts/check-project.mjs",
    "audit:schema": "node scripts/audit-schema-code.mjs",
    "smoke": "node scripts/smoke-local.mjs",
    "sync:news": "node scripts/sync-news.mjs",
    "import:opportunities": "node scripts/import-tech-opportunities.mjs",
    "import:fp-content": "node scripts/import-fp-content.mjs",
    "validate:fp-content": "node scripts/validate-fp-content-csv.mjs",
    "import:courses": "node scripts/import-courses.mjs",
    "import:hackathons": "node scripts/import-hackathons.mjs",
    "seed:fp-demo-users": "node scripts/seed-fp-demo-users.mjs",
    "verify:startup": "npm run check:project && npm run audit:schema && npm run typecheck",
    "verify:cheap": "npm run verify:startup && npm run lint",
    "verify:prod": "npm run stop:app && npm run build:clean && node scripts/smoke-production.mjs",
    "test": "npm run check:project && npm run validate:fp-content && npm run typecheck",
    "ci": "npm run lint && npm run test && npm run build",
    "validate:deploy": "node scripts/validate-deploy-readiness.mjs",
    "postgres:setup": "node scripts/setup-postgres-schema.mjs",
    "validate:postgres-migration": "node scripts/validate-postgres-migration-readiness.mjs",
    "postgres:sandbox:up": "docker compose -f infra/docker-compose.postgres-sandbox.yml up -d",
    "postgres:sandbox:down": "docker compose -f infra/docker-compose.postgres-sandbox.yml down",
    "postgres:sandbox:down:volumes": "docker compose -f infra/docker-compose.postgres-sandbox.yml down -v",
    "postgres:sandbox:logs": "docker compose -f infra/docker-compose.postgres-sandbox.yml logs -f aidraft_postgres_sandbox",
    "postgres:schema:validate-sandbox": "node scripts/validate-postgres-schema-sandbox.mjs",
    "migration:import:sandbox": "node scripts/migration/import-sandbox-data.mjs",
    "migration:verify:sandbox": "node scripts/migration/verify-sandbox-migration.mjs",
    "migration:validate:artifacts": "node scripts/migration/validate-migration-artifacts.mjs",
    "validate:postgres-app-integration": "node scripts/validate-postgres-app-integration.mjs",
    "validate:production-deploy": "node scripts/validate-production-deploy-readiness.mjs",
    "migration:import:production": "node scripts/migration/import-production-data.mjs",
    "migration:verify:production": "node scripts/migration/verify-production-migration.mjs",
    "postgres:user:set-password": "node scripts/postgres/set-user-password.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
