# ── PostgreSQL propio (aidraft_postgres) ─────────────────────────────────────
# Conexión principal usada por la app y los scripts de migración/import.
DATABASE_URL=postgresql://aidraft:REPLACE_ME@aidraft_postgres:5432/aidraft
POSTGRES_PASSWORD=REPLACE_ME

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase variables are kept temporarily during the migration.
# They will be removed when the application no longer depends on Supabase Auth/client.
# Obtén estos valores en: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME

# Service role key — NUNCA exponer en cliente
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_SECRET_KEY=REPLACE_ME
SUPABASE_URL=https://REPLACE_ME.supabase.co

# Supabase Dashboard → Project Settings → Database → Connection string → Direct
SUPABASE_DB_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
TARGET_USER_EMAIL=REPLACE_ME@example.com

# Contraseña compartida para los perfiles internos (Dani, Luli, etc.)
PROFILES_SHARED_PASSWORD=REPLACE_ME

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://aidraft.danielcode.dev/api/google/calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_ME

# ── URLs de producción ────────────────────────────────────────────────────────
BASE_URL=https://aidraft.danielcode.dev

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
