# ── PostgreSQL propio (al_lio_postgres) ──────────────────────────────────────
# La aplicación usa exclusivamente el rol limitado al_lio_app.
DATABASE_URL=postgresql://al_lio_app:REPLACE_ME@al_lio_postgres:5432/al_lio
# Solo para tareas puntuales de migración/administración. Esta variable no se
# inyecta en el contenedor web normal.
DATABASE_MIGRATION_URL=postgresql://al_lio:REPLACE_ME@al_lio_postgres:5432/al_lio
POSTGRES_PASSWORD=REPLACE_ME

# ── Sesión propia ─────────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Genera una con: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME

# ── App ───────────────────────────────────────────────────────────────────────
TARGET_USER_EMAIL=REPLACE_ME@example.com

# Demo users for controlled company demos. Leave empty unless explicitly needed.
# Seed requires AL_LIO_SEED_DEMO_CONFIRMATION=SEED_FP_DEMO_USERS.
AL_LIO_SEED_DEMO_CONFIRMATION=
AL_LIO_DEMO_PASSWORD=
# Actívalo explícitamente solo durante demos controladas.
AL_LIO_DEMO_ACCESS_ENABLED=false

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://al-lio.danielcode.dev/api/google/calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_ME

# ── URLs de producción ────────────────────────────────────────────────────────
BASE_URL=https://al-lio.danielcode.dev

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
AL_LIO_IMAGE_TAG=REPLACE_WITH_GIT_SHA

# PostgreSQL runtime
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
